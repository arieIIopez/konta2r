# Konta2r custom Edge Function secrets only.
# Supabase automatically provides SUPABASE_URL, SUPABASE_DB_URL,
# SUPABASE_PUBLISHABLE_KEYS, SUPABASE_SECRET_KEYS and SUPABASE_JWKS.
# Never commit a populated copy of this file.

# Credential HMAC keyring. Generate each pepper independently, for example:
#   openssl rand -hex 32
KONTA2R_NODE_TOKEN_ACTIVE_KEY_VERSION=1
KONTA2R_NODE_TOKEN_PEPPER_V1=REPLACE_WITH_RANDOM_SECRET

# Rotation procedure:
# 1. add KONTA2R_NODE_TOKEN_PEPPER_V2 while V1 still exists;
# 2. set KONTA2R_NODE_TOKEN_ACTIVE_KEY_VERSION=2;
# 3. rotate live node credentials through node-lifecycle;
# 4. retire V1 only after no stored credential has key_version=1.

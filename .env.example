# Browser-safe Supabase configuration only.
# Never place sb_secret_* / service_role / database passwords in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Google OAuth client secret belongs in Supabase/Google configuration, never here.

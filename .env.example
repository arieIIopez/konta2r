# Browser-safe Supabase configuration only.
# Never place sb_secret_* / service_role / database passwords in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Google OAuth client secret belongs in Supabase/Google configuration, never here.

# Optional field-pilot detector. Leave unset in standard builds.
# `nanodet` downloads the registered external OpenCV Zoo candidate at first node start,
# verifies its SHA-256 before ONNX Runtime and caches verified bytes locally when possible.
# This does NOT mark the candidate as selected for production or weights redistribution.
# VITE_KONTA2R_EXPERIMENTAL_DETECTOR=nanodet
